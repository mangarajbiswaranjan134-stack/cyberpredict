# ==============================================================================
# CYBERPREDICT: National Cybercrime Predictive Intelligence Platform
# Environment Configuration Template (.env.example)
# ==============================================================================

# 1. DATABASE CONFIGURATION
# Production PostgreSQL Connection String
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/cyberpredict

# 2. APPLICATION & SECURITY
HOST=0.0.0.0
PORT=8000
JWT_SECRET=cyberpredict-super-secret-key-sih-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. PUBLIC REAL DATA SOURCES (Connected & Active)
# Razorpay National Banking IFSC Directory (Open Public API - No key required)
ENABLE_PUBLIC_IFSC_LOOKUP=true

# 4. EXTERNAL AUTHORIZED GOVERNMENT & BANKING APIS (Credentials Required for Live Production)
# To connect to live authorized feeds instead of demonstration mode, configure:
# NCRP (National Cybercrime Reporting Portal 1930) Live Gateway:
# NCRP_API_GATEWAY_URL=https://ncrp.gov.in/api/v2/complaints/stream
# NCRP_REST_GATEWAY_KEY=your_authorized_ncrp_api_token_here

# I4C (Indian Cybercrime Coordination Centre) Command Portal:
# I4C_PORTAL_URL=https://i4c.mha.gov.in/api/interventions
# I4C_PORTAL_TOKEN=your_mha_authorized_token_here

# Open Government Data (data.gov.in) API:
# DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Core Banking System (CBS) Layer-2 Mule Freezing Gateway:
# RBI_NODAL_BANKING_API_KEY=your_authorized_rbi_cbs_key_here
